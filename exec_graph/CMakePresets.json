{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/exec_graph",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan + UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/exec_graph_asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EG_ENABLE_ASAN": "ON",
        "EG_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/exec_graph_tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "EG_ENABLE_TSAN": "ON"
      }
    }
  ]
}
